{
  "extends": "./tsconfig.nodejs.json",
  "compilerOptions": {
    /* 生成装饰器类型元数据，供 NestJS 依赖注入等功能使用。 */
    "emitDecoratorMetadata": true,

    /* 启用 NestJS 使用的传统装饰器语法，包括构造函数和方法的参数装饰器。 */
    "experimentalDecorators": true,

    /* 允许 DTO 和框架注入的属性不在构造函数中初始化，其他严格类型检查仍然生效。 */
    "strictPropertyInitialization": false,

    /* 允许生成 JavaScript 等产物；输出目录由项目通过 outDir 指定。 */
    "noEmit": false,

    /* 生成源码映射，方便调试时定位到原始 TypeScript 代码。 */
    "sourceMap": true
  }
}
