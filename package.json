{
  "name": "@ringotangs/tsconfig",
  "version": "0.2.0",
  "packageManager": "pnpm@10.24.0",
  "description": "The simplest way to set up your tsconfig.json.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/tsconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RingoTangs/tsconfig.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/tsconfig/issues"
  },
  "keywords": [
    "typescript",
    "tsconfig",
    "configuration",
    "shared-config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "tsconfig": "./src/tsconfig.bundler.json",
  "exports": {
    ".": "./src/tsconfig.bundler.json",
    "./bundler": "./src/tsconfig.bundler.json",
    "./react": "./src/tsconfig.react.json",
    "./nodejs": "./src/tsconfig.nodejs.json",
    "./nestjs": "./src/tsconfig.nestjs.json"
  },
  "files": [
    "src/tsconfig.base.json",
    "src/tsconfig.bundler.json",
    "src/tsconfig.nestjs.json",
    "src/tsconfig.nodejs.json",
    "src/tsconfig.react.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --project test/fixtures/bundler/tsconfig.json && tsc --project test/fixtures/react/tsconfig.json && tsc --project test/fixtures/nodejs/tsconfig.json && tsc --project test/fixtures/nestjs/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm typecheck && pnpm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm check && pnpm pack:check"
  },
  "peerDependencies": {
    "typescript": ">=5.8.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~5.8.0",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  }
}
